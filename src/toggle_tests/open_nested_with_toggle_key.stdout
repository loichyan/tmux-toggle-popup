TMUX:BEGIN[1] {
	TMUX=tmux-test
	TMUX_POPUP_SERVER=
	SHELL=/system/shell
}
	run-shell
	-C
	run "#{@popup_before_open}"
	;
	display-popup
	-e
	TMUX_POPUP_SERVER=popup_test
	TMUX:BEGIN[2] {
		TMUX=tmux-test
		TMUX_POPUP_SERVER=
		SHELL=/system/shell
	}
		-S
		/tmp/tmux-3000/popup_test
		new-session
		-As
		default_id_format/p_nested_toggle_key_2
		-e
		__tmux_popup_name=p_nested_toggle_key_2
		;
		setenv
		__tmux_popup_caller
		%current_pane_id:tmux-test
		;
		bind-key
		-n
		M-o
		run
		#{@popup-toggle} --name=p_nested_toggle_key_2 --toggle-key=-n\ M-o
		;
		run-shell
		-C
		run "#{@popup_on_init}"
		;
	TMUX:END[2]
	;
	run-shell
	-C
	run "#{@popup_after_close}"
	;
TMUX:END[1]
